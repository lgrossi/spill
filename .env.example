DATABASE_URL=postgres://spillio:spillio@localhost:5432/spillio
SPILLIO_API_ADDR=127.0.0.1:4000
SPILLIO_API_URL=http://127.0.0.1:4000
SPILLIO_KLIPY_API_KEY=
SPILLIO_AUTH_MODE=local
RUST_LOG=info

# --- API authentication ---
# When SPILLIO_AUTH_MODE is unset/local the API trusts the on-behalf-of header
# directly (dev only). When SPILLIO_TOKEN_SECRET is set (or SPILLIO_AUTH_MODE=token)
# the API requires a first-party token signed with that shared secret and refuses
# to start without it. The web tier (behind its own auth proxy) is the sole token
# minter for REST, WebSocket, and the companion CLI; identity is carried in the
# signed token, not a header. No OIDC, JWKS, or service account is involved.
#
# SPILLIO_AUTH_MODE=token
# Shared HMAC secret (web signs, API verifies). The web reads the same value.
# SPILLIO_TOKEN_SECRET=
